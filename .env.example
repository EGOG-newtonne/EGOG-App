# Runtime environment: use development locally/Dev and demo only in Demo.
NEXT_PUBLIC_APP_ENV=development

# Privy public application identifier used by the browser SDK.
NEXT_PUBLIC_PRIVY_APP_ID=
# Public Pinata gateway base URL for IPFS assets.
NEXT_PUBLIC_PINATA_GATEWAY_URL=
# Browser-safe GIWA Testnet RPC endpoint.
NEXT_PUBLIC_GIWA_RPC_URL=
# GIWA Testnet explorer base URL.
NEXT_PUBLIC_GIWA_EXPLORER_URL=
# GIWA Testnet chain ID; expected format is a decimal number.
NEXT_PUBLIC_GIWA_CHAIN_ID=
# Active Dev or Demo participation contract address.
NEXT_PUBLIC_PARTICIPATION_CONTRACT_ADDRESS=

# Supabase transaction pooler URL for serverless runtime connections.
DATABASE_URL=
# Direct Supabase Postgres URL for migrations only.
DATABASE_DIRECT_URL=
# Privy server application secret.
PRIVY_APP_SECRET=
# Pinata server JWT used to upload public IPFS files.
PINATA_JWT=
# Private S3 bucket for raw data and backups.
AWS_S3_BUCKET=
# AWS region containing the S3 bucket.
AWS_REGION=
# Least-privilege S3 access key identifier.
AWS_ACCESS_KEY_ID=
# Least-privilege S3 secret access key.
AWS_SECRET_ACCESS_KEY=
# Server-side GIWA Testnet RPC endpoint.
GIWA_RPC_URL=
# Server-side GIWA Testnet chain ID.
GIWA_CHAIN_ID=
# Active Dev or Demo participation contract address used by the server.
PARTICIPATION_CONTRACT_ADDRESS=
# Dev or Demo Relayer wallet private key.
GIWA_RELAYER_PRIVATE_KEY=
# Shared Bearer secret protecting the on-chain recovery endpoint.
ONCHAIN_SYNC_SECRET=
