{
  "name": "eogo-mvp",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24.13.1 <25",
    "pnpm": ">=10.33.2 <11"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "test:web": "vitest run --project web",
    "test:server": "vitest run --project server",
    "test:shared": "vitest run --project shared",
    "test:contracts": "pnpm --filter @eogo/contracts test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/jsdom": "28.0.3",
    "eslint": "10.7.0",
    "globals": "17.7.0",
    "jsdom": "29.1.1",
    "turbo": "2.10.4",
    "typescript-eslint": "8.63.0",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
